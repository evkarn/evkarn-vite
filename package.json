{
	"name": "evkarn-vite",
	"version": "1.0.0",
	"description": "Vite-сборка для вёрстки сайтов: SCSS, HTML-включения, спрайты, картинки WebP/AVIF, деплой",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"preview": "vite preview",
		"fonts": "node scripts/convert-fonts.mjs",
		"copy-static": "node scripts/copy-static.mjs",
		"deploy:zip": "npm run build && node scripts/deploy-zip.mjs",
		"deploy:ftp": "npm run build && node scripts/deploy-ftp.mjs",
		"deploy:ssh": "npm run build && node scripts/deploy-ssh.mjs",
		"lint:js": "eslint .",
		"lint:js:fix": "eslint . --fix",
		"lint:css": "stylelint \"**/*.{css,scss,pcss}\"",
		"lint:css:fix": "stylelint \"**/*.{css,scss,pcss}\" --fix",
		"format": "prettier . --check",
		"format:fix": "prettier . --write",
		"lint": "npm run lint:js && npm run lint:css && npm run format",
		"lint:fix": "npm run lint:js:fix && npm run lint:css:fix && npm run format:fix"
	},
	"author": "evkarn.ru",
	"license": "MIT",
	"engines": {
		"node": ">=20"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"archiver": "^8.0.0",
		"autoprefixer": "^10.6.0",
		"basic-ftp": "^6.2.1",
		"cssnano": "^8.0.10",
		"dotenv": "^17.4.2",
		"eslint": "^10.10.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.6",
		"glob": "^13.0.6",
		"globals": "^17.12.0",
		"html-minifier-terser": "^7.2.0",
		"node-ssh": "^13.2.1",
		"postcss-preset-env": "^11.5.3",
		"postcss-pxtorem": "^6.1.0",
		"postcss-sort-media-queries": "^6.7.1",
		"prettier": "^3.9.6",
		"sass": "^1.104.1",
		"sharp": "^0.35.4",
		"stylelint": "^17.15.0",
		"stylelint-config-standard": "^40.0.0",
		"stylelint-config-standard-scss": "^17.0.0",
		"stylelint-order": "^8.1.1",
		"stylelint-scss": "^7.2.0",
		"stylelint-selector-bem-pattern": "^5.0.0",
		"svg-sprite": "^2.0.4",
		"svgo": "^2.8.2",
		"ttf2woff2": "^6.0.1",
		"vite": "^8.3.0"
	},
	"dependencies": {
		"@popperjs/core": "^2.11.8",
		"aos": "^2.3.4",
		"custom-select": "^1.1.15",
		"ilyabirman-likely": "^3.2.0",
		"inputmask": "^5.0.10",
		"jquery": "^4.0.0",
		"just-validate": "^4.3.0",
		"micromodal": "^0.7.0",
		"resize-observer-polyfill": "^1.5.1",
		"shareon": "^2.8.1",
		"simplebar": "^6.3.3",
		"swiper": "^14.2.0",
		"transfer-elements": "^1.0.7"
	}
}
