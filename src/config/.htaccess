AddDefaultCharset UTF-8
Options -Indexes

RewriteEngine On
RewriteBase /

# ========== НАСТРОЙКА HTTPS ДЛЯ ПРОКСИ ==========
# Если заголовок X-Forwarded-Proto равен https, устанавливаем переменную окружения HTTPS=on
SetEnvIf X-Forwarded-Proto https HTTPS=on

# ========== ЕДИНЫЙ РЕДИРЕКТ: HTTPS + убираем www ==========
# Если включён www ИЛИ не включён HTTPS – редиректим на https://без-www
RewriteCond %{HTTP_HOST} ^www\. [NC,OR]
RewriteCond %{ENV:HTTPS} !on
RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
RewriteRule ^(.*)$ https://%1/$1 [L,R=301]

# ========== БЕЗОПАСНОСТЬ ==========
# Запрет доступа к скрытым файлам
RewriteRule ^(.*/)?\.(htaccess|htpasswd|env|git|svn|DS_Store) - [F,L]

# Страница 404
ErrorDocument 404 /404.html

# ========== ЗАПРЕТ ИНДЕКСАЦИИ ДЛЯ ПОИСКОВЫХ РОБОТОВ ==========
# Определяем переменную search_bot для известных ботов
<IfModule mod_setenvif.c>
    SetEnvIfNoCase User-Agent "Googlebot" search_bot
    SetEnvIfNoCase User-Agent "Yandex" search_bot
    SetEnvIfNoCase User-Agent "Yahoo" search_bot
    SetEnvIfNoCase User-Agent "Aport" search_bot
    SetEnvIfNoCase User-Agent "msnbot" search_bot
    SetEnvIfNoCase User-Agent "spider" search_bot
    SetEnvIfNoCase User-Agent "Robot" search_bot
    SetEnvIfNoCase User-Agent "php" search_bot
    SetEnvIfNoCase User-Agent "Mail" search_bot
    SetEnvIfNoCase User-Agent "bot" search_bot
    SetEnvIfNoCase User-Agent "igdeSpyder" search_bot
    SetEnvIfNoCase User-Agent "Snapbot" search_bot
    SetEnvIfNoCase User-Agent "WordPress" search_bot
    SetEnvIfNoCase User-Agent "BlogPulseLive" search_bot
    SetEnvIfNoCase User-Agent "Parser" search_bot
    # Дополнительные популярные боты
    SetEnvIfNoCase User-Agent "Baiduspider" search_bot
    SetEnvIfNoCase User-Agent "DuckDuckBot" search_bot
    SetEnvIfNoCase User-Agent "facebookexternalhit" search_bot
    SetEnvIfNoCase User-Agent "Twitterbot" search_bot
    SetEnvIfNoCase User-Agent "WhatsApp" search_bot
    SetEnvIfNoCase User-Agent "SemrushBot" search_bot
    SetEnvIfNoCase User-Agent "AhrefsBot" search_bot
    SetEnvIfNoCase User-Agent "MJ12bot" search_bot
    SetEnvIfNoCase User-Agent "DotBot" search_bot
    SetEnvIfNoCase User-Agent "SeznamBot" search_bot
    SetEnvIfNoCase User-Agent "bingbot" search_bot
    SetEnvIfNoCase User-Agent "Slurp" search_bot
    SetEnvIfNoCase User-Agent "DuckDuckGo" search_bot
</IfModule>

# ========== КЕШИРОВАНИЕ ==========
<IfModule mod_expires.c>
    AddType application/font-woff2 .woff2
    AddType image/svg+xml .svg

    ExpiresActive On
    ExpiresDefault "access plus 1 year"

    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType application/x-javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"

    ExpiresByType text/html "access plus 1 hour"

    ExpiresByType image/* "access plus 1 year"
    ExpiresByType video/* "access plus 1 year"
    ExpiresByType audio/* "access plus 1 year"
    ExpiresByType application/font-* "access plus 1 year"
    ExpiresByType font/* "access plus 1 year"
    ExpiresByType application/x-font-* "access plus 1 year"

    ExpiresByType application/json "access plus 0 seconds"
    ExpiresByType application/ld+json "access plus 0 seconds"
    ExpiresByType application/xml "access plus 0 seconds"
    ExpiresByType text/xml "access plus 0 seconds"
</IfModule>

# ========== СЖАТИЕ ==========
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript
    AddOutputFilterByType DEFLATE application/xml application/xhtml+xml
    AddOutputFilterByType DEFLATE application/json application/ld+json
    AddOutputFilterByType DEFLATE application/font-woff2 image/svg+xml

    <IfModule mod_setenvif.c>
        BrowserMatch ^Mozilla/4 gzip-only-text/html
        BrowserMatch ^Mozilla/4\.0[678] no-gzip
        BrowserMatch \bMSIE !no-gzip !gzip-only-text/html
    </IfModule>
</IfModule>

# ========== ЗАГОЛОВКИ БЕЗОПАСНОСТИ + X-Robots-Tag ==========
<IfModule mod_headers.c>
    # Заголовки безопасности
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "no-referrer-when-downgrade"
    # HSTS (раскомментируйте, если уверены)
    # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

    # Запрет индексации для поисковых роботов (отправляется только если переменная search_bot определена)
    Header set X-Robots-Tag "noindex, nofollow" env=search_bot
</IfModule>