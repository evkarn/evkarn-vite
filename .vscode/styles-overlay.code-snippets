{
	"Overlay before": {
		"prefix": "overlay-before",
		"scope": "css, sass, scss, less",
		"body": [
			"&:before {",
			"\tcontent: '';",
			"",
			"\tposition: absolute;",
			"\tinset: 0;",
			"",
			"\tdisplay: block;",
			"",
			"\tbackground-color: var($1);",
			"\topacity: $1;",
			"}",
		],
	},
	"Overlay after": {
		"prefix": "overlay-after",
		"scope": "css, sass, scss, less",
		"body": [
			"&:after {",
			"\tcontent: '';",
			"",
			"\tposition: absolute;",
			"\tinset: 0;",
			"",
			"\tdisplay: block;",
			"",
			"\tbackground-color: var($1);",
			"\topacity: $1;",
			"}",
		],
	},
}