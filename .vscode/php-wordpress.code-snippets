	"Фильтрация трейлинг слэшев": {
		"prefix": "wp-filter-trailing-slash",
		"scope": "html, php, njk, md",
		"body": [
			"add_filter( 'wp_kses_allowed_html', function( \\$tags ) {",
			"\tforeach (['img', 'br', 'hr', 'input', 'meta', 'link'] as \\$tag) {",
			"\t\tif (isset(\\$tags[\\$tag])) {",
			"\t\t\tunset(\\$tags[\\$tag]['slash']);",
			"\t\t}",
			"\t}",
			"\treturn \\$tags;",
			"} );",
		],
	},

	"Добавление стилей для админки вордпресс": {
		"prefix": "wp-add-styles-for-admin-panel",
		"scope": "html, php, njk, md",
		"body": [
			"function my_admin_style() {",
			"\t wp_enqueue_style('admin-styles', get_stylesheet_directory_uri().'/my-admin.css');",
			"}",
			"add_action( 'admin_enqueue_scripts', 'my_admin_style' );",
		],
	},

