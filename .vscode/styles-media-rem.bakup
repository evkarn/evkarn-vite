{
	// General
	"Media Screen max-width switch-point em": {
		"prefix": "@max-switch-rem-rem",
		"scope": "css, sass, scss, less",
		"body": [
			"@media ( max-width: units.rem(grid.\\$max-switch-point) ) {",
			"\t$2",
			"}"
		],
	},
	"Media Screen min-width switch-point em": {
		"prefix": "@min-switch-rem-rem",
		"scope": "css, sass, scss, less",
		"body": [
			"@media ( min-width: units.rem(grid.\\$min-switch-point) ) {",
			"\t$2",
			"}"
		],
	},
