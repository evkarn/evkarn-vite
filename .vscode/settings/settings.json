		"*.woff2": "default"
	},
	"[php]": {
		"editor.formatOnSave": true,
		"editor.defaultFormatter": "bmewburn.vscode-intelephense-client"
	},
	"editor.codeActionsOnSave": {},
	"javascript.updateImportsOnFileMove.enabled": "always",
	"editor.formatOnSave": true,
	"prettier.singleQuote": true,
	// Formatter
	"editor.defaultFormatter": "esbenp.prettier-vscode",
	"[html]": {
		"editor.defaultFormatter": "vscode.html-language-features"
	},
	"[css]": {
		"editor.defaultFormatter": "vscode.css-language-features"
	},
	"[javascript]": {
		"editor.defaultFormatter": "vscode.typescript-language-features"
	},
	"[sass]": {
		"editor.defaultFormatter": "syler.sass-indented"
	},
	"editor.bracketPairColorization.independentColorPoolPerBracketType": true,
	"editor.glyphMargin": false,
	"ecsstractor_port.modifier_separator": "--",
	"prettier.jsxSingleQuote": true,
	"prettier.useTabs": true,
	"editor.accessibilitySupport": "off",
	"liveServer.settings.donotShowInfoMsg": true,
	"[scss]": {
		"editor.defaultFormatter": "vscode.css-language-features"
	},
	"html.format.wrapAttributes": "force-expand-multiline",
	"editor.tabCompletion": "onlySnippets",
	"editor.formatOnPaste": true,
	"diffEditor.experimental.showMoves": true,
	"workbench.colorTheme": "Dark+",
	"[jsonc]": {
		"editor.defaultFormatter": "vscode.json-language-features"
	},
	"editor.unicodeHighlight.invisibleCharacters": false,
	"prettier.requireConfig": true,
	"[twig]": {
		"editor.defaultFormatter": "mblode.twig-language-2"
	},
	"editor.fontSize": 18,
	"files.associations": {
		"*.tpl": "php",
		"*.mdx": "markdown"
	},
	"liveServer.settings.donotVerifyTags": true,
	"[xml]": {
		"editor.defaultFormatter": "mikeburgh.xml-format"
	},
	"diffEditor.maxComputationTime": 0,
	"[snippets]": {
		"editor.defaultFormatter": "vscode.json-language-features"
	},
	"editor.dragAndDrop": false,
	"editor.unicodeHighlight.ambiguousCharacters": false,
	"[ini]": {
		"editor.defaultFormatter": "lkrms.inifmt"
	},
	"telemetry.telemetryLevel": "error",
	"js/ts.implicitProjectConfig.strictFunctionTypes": false,
	"js/ts.implicitProjectConfig.strictNullChecks": false,
	"update.mode": "start",
	"php.validate.executablePath": "E:\\Local Programs\\php-8.5.4-Win32-vs17-x64\\php.exe",
	"[astro]": {
		"editor.defaultFormatter": "astro-build.astro-vscode"
	},
