			"",
			"\t<source srcset=\"/assets/images/$1.avif\" type=\"image/avif\">",
			"",
			"\t<img class=\"$2__img\" src=\"/assets/images/$1.jpg\" width=\"$3\" height=\"$4\" alt=\"$6\" loading=\"lazy\" decoding=\"async\">",
			"</picture>",
		],
	},

	"Picture tag with .avif + .webp @2x abs": {
		"prefix": "pic@2xAvifWebp-abs",
		"scope": "html, php, njk, md",
		"body": [
			"<picture class=\"$1__picture\">",
			"\t<source srcset=\"/assets/images/$2.webp, /assets/images/$2@2x.webp 2x\" type=\"image/webp\">",
			"",
			"\t<source srcset=\"/assets/images/$2.avif, /assets/images/$2@2x.avif 2x\" type=\"image/avif\">",
