# Скопируйте этот файл в .env и заполните своими данными: cp .env.example .env
# Файл .env добавлен в .gitignore и не попадает в репозиторий.
# Никогда не прописывайте пароли прямо в коде конфигов.

# --- Выгрузка на FTP (npm run deploy:ftp) ---
FTP_HOST=
FTP_USER=
FTP_PASSWORD=

# Папка на сервере, в которую ляжет сборка (необязательно,
# по умолчанию — имя папки проекта)
#FTP_REMOTE_PATH=evkarn-vite

# Количество одновременных потоков загрузки (по умолчанию 5)
#FTP_PARALLEL=5

# FTPS вместо plain-FTP (необязательно):
#   1 / explicit — TLS, в явном виде
#FTP_SECURE=1

# --- Выгрузка по SSH/SFTP (npm run deploy:ssh) ---
SSH_HOST=
SSH_USER=
SSH_DESTINATION=/var/www/user/public_html/example.ru

# Порт SSH (по умолчанию 22)
#SSH_PORT=22

# Способ аутентификации (по одному из вариантов):
# 1) Пароль:
#SSH_PASSWORD=
# 2) Ключ (путь к файлу приватного ключа):
#SSH_PRIVATE_KEY_PATH=~/.ssh/id_rsa
# 3) Содержимое ключа — SSH_PRIVATE_KEY (не рекомендуется, лучше файл)
# 4) Ничего — тогда используется ssh-agent

# Количество одновременных потоков загрузки (по умолчанию 5)
#SSH_PARALLEL=5

# --- Минификация HTML при сборке (npm run build) ---
# true — минифицировать (по умолчанию)
# false — не минифицировать (отладка)
HTML_MINIFY=false